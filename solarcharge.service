# Edit User and the paths below if you don't use the pi user and /home/pi/solarcharge
[Unit]
Description=SolarCharge solar surplus Tesla charging
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/solarcharge
ExecStart=/usr/bin/python3 -u /home/pi/solarcharge/solarcharge.py
Restart=always
RestartSec=15
Nice=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
